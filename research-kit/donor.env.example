# donor.env -- settings for run.sh (and the compose files). Copy to donor.env and edit. Every line is optional.
# The defaults keep 2 CPU threads, the rest of your RAM above 24 GB, and your desktop for you.

DONOR_VARIANT=rocm                 # rocm (AMD) | cuda (NVIDIA)
# DONOR_IMAGE=ghcr.io/theherobrine422/rad-quant-at-home-research:0.3.0-rocm   (default: this kit's version)
TS_HOSTNAME=donor-yourname         # the machine's name on our Tailscale network
# TS_AUTHKEY=tskey-auth-...        # the one-time key we send you; first start only (run.sh moves it into the data
                                   # volume, the container uses and deletes it). Delete this line after the first start.

# limits (Docker syntax)
DONOR_CPUS=14                      # CPU threads the container may use (default: all but 2)
DONOR_MEM=24g                      # RAM, hard cap; no swap on top
DONOR_PIDS=4096                    # processes / threads
DONOR_SHM=8g                       # /dev/shm (counts towards DONOR_MEM when used)

# GPUs
# DONOR_DRI="renderD129"           # AMD: lend only some cards (ls -l /dev/dri/by-path); default: all of /dev/dri
# DONOR_GPUS=device=0              # NVIDIA: all (default) | device=0 | device=0,1
# DONOR_SECCOMP=kit                # AMD: kit (Docker's default profile + the NUMA calls ROCm makes; default) | default
# DONOR_SELINUX_LABEL=disable      # Fedora / RHEL, only if the GPU is denied: prefer `sudo setsebool -P container_use_devices 1`

# storage: a named Docker volume (default) or an absolute path owned by uid 10010
# DONOR_DATA=donor-research-data
