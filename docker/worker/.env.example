# Copy to .env next to compose.yaml. Never commit or share .env: the invite / token are secrets.
#RQAH_IMAGE=ghcr.io/theherobrine422/rad-quant-at-home-worker:0.5.0-rocm7.14-gfx1201
RQAH_SERVER=https://queue.example.org
# the invite from us (first start only); empty: the worker registers without one and starts on probation
RQAH_INVITE=
RQAH_NAME=donor
# 1: list RQAH_NAME on the public status page (opt-in; change later with `rqah config set --leaderboard on|off`)
#RQAH_LEADERBOARD=0
# getent group video render  ->  the third field of each line
VIDEO_GID=
RENDER_GID=
#RQAH_GPU_NAME=r9700
#RQAH_GPUS=0
#RQAH_VRAM_GB=32
#RQAH_RAM_GB=30
#RQAH_CACHE_GB=200
#RQAH_WINDOWS=22:00-08:00
#RQAH_ON_STOP=finish
# data caps / slow links (README "Data caps"): rates in Mbit/s, budgets in GB per calendar day / month, local time
#RQAH_MAX_DOWN_MBPS=50
#RQAH_MAX_UP_MBPS=10
#RQAH_MAX_DOWN_GB_MONTH=300
#RQAH_MAX_UP_GB_MONTH=100
#RQAH_MAX_DOWN_GB_DAY=
#RQAH_MAX_UP_GB_DAY=
#RQAH_BUDGET_RESET_DAY=1
#TZ=Europe/Berlin
#RQAH_STATE_DIR=/srv/rad-quant-at-home-worker
#RQAH_MEM_LIMIT=32g
#RQAH_STOP_GRACE=15m
