# Copy to .env next to compose.yaml. Never commit or share .env: the invite / token are secrets.
#RQAH_IMAGE=docker.io/<hub-user>/rad-quant-at-home-worker:0.3.0-rocm7.14-gfx1201
RQAH_SERVER=https://queue.example.org
RQAH_INVITE=
RQAH_NAME=donor
# 1: list RQAH_NAME on the public status page (opt-in; change later with `rqah config set --leaderboard on|off`)
#RQAH_LEADERBOARD=0
# getent group video render  ->  the third field of each line
VIDEO_GID=
RENDER_GID=
#RQAH_GPU_NAME=r9700
#RQAH_GPUS=0
#RQAH_VRAM_GB=32
#RQAH_RAM_GB=30
#RQAH_CACHE_GB=200
#RQAH_WINDOWS=22:00-08:00
#RQAH_ON_STOP=finish
#TZ=Europe/Berlin
#RQAH_STATE_DIR=/srv/rad-quant-at-home-worker
#RQAH_MEM_LIMIT=32g
#RQAH_STOP_GRACE=15m
